# Supabase Database & Auth (Set in Vercel Project Settings)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Supabase PostgreSQL Pooler (Required for Prisma on Vercel)
DATABASE_URL="postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=20"
DIRECT_URL="postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Application URL (Optional - defaults to Vercel auto URL)
NEXT_PUBLIC_APP_URL=""

# AI Integration API Keys (Optional)
COHERE_API_KEY=""
GEMINI_API_KEY=""

# Security
SESSION_SECRET="institutional-queue-management-super-secret-key-32chars"
CLOUDFLARE_TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
